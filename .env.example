# 环境变量示例（复制为 .env 后填写，.env 不入库）
# 生产环境务必设置 ENV=prod，否则不会启用密钥强度校验

ENV=prod

# JWT 签名密钥：必须 ≥32 位随机串
# 生成方式：openssl rand -base64 48
JWT_SECRET=

# 初始管理员密码（仅首次启动创建用户时使用，之后不生效）
INIT_ADMIN_PASSWORD=

# 数据库：生产使用 MySQL，留空则回退 SQLite
DATABASE_URL=mysql+pymysql://fiber:CHANGE_ME@127.0.0.1:3306/fiber?charset=utf8mb4

# API 前缀（作为子服务嵌入其它项目时可改）
API_PREFIX=/fiber/api/v1

# 认证模式：local | external
AUTH_MODE=local

# CORS 允许来源，逗号分隔。同源部署留空即可；生产禁止填 *
CORS_ORIGINS=

# 上传体积上限（字节），默认 10MB
MAX_UPLOAD_BYTES=10485760
